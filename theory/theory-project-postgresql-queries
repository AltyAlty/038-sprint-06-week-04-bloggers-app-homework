Запросы для создания БД для этого приложения (нужен только первый запрос для создания БД):

CREATE DATABASE "038-s-06-w-04-bloggers-app-hw"
	WITH
		OWNER = postgres
		ENCODING = 'UTF8'
		LOCALE_PROVIDER = 'libc'
		CONNECTION LIMIT = -1
		IS_TEMPLATE = False;

CREATE TABLE public.users (
	id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
	login VARCHAR(10) NOT NULL UNIQUE,
	original_email VARCHAR(1000) NOT NULL,
	email VARCHAR(1000) NOT NULL UNIQUE,
	password_hash VARCHAR(1000) NOT NULL,
	is_confirmed BOOLEAN NOT NULL DEFAULT false,
	created_at TIMESTAMP NOT NULL DEFAULT NOW(),
	deleted_at TIMESTAMP DEFAULT NULL
);

CREATE TABLE public.email_confirmations (
	id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
	user_id UUID NOT NULL,
	confirmation_code VARCHAR(100) NOT NULL,
	expiration_date TIMESTAMP NOT NULL,
	FOREIGN KEY (user_id)
		REFERENCES public.users (id) MATCH SIMPLE
		ON UPDATE NO ACTION
		ON DELETE NO ACTION
);

CREATE TABLE public.password_recovery_codes_data (
	id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
	user_id UUID NOT NULL,
	password_recovery_code VARCHAR(100) NOT NULL,
	expiration_date TIMESTAMP NOT NULL,
	FOREIGN KEY (user_id)
		REFERENCES public.users (id) MATCH SIMPLE
		ON UPDATE NO ACTION
		ON DELETE NO ACTION
);

CREATE TABLE public.security_devices (
	device_id UUID PRIMARY KEY,
	user_id UUID NOT NULL,
	title VARCHAR(1000) NOT NULL,
	ip VARCHAR(100) NOT NULL,
	last_active_date TIMESTAMP NOT NULL,
	created_at TIMESTAMP NOT NULL DEFAULT NOW(),
	FOREIGN KEY (user_id)
		REFERENCES public.users (id) MATCH SIMPLE
		ON UPDATE NO ACTION
		ON DELETE NO ACTION
);

CREATE TABLE public.sessions (
	id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
	user_id UUID NOT NULL,
	device_id UUID NOT NULL,
	iat TIMESTAMP NOT NULL,
	exp TIMESTAMP NOT NULL,
	created_at TIMESTAMP NOT NULL DEFAULT NOW(),
	FOREIGN KEY (user_id)
		REFERENCES public.users (id) MATCH SIMPLE
		ON UPDATE NO ACTION
		ON DELETE NO ACTION,
	FOREIGN KEY (device_id)
		REFERENCES public.security_devices (device_id) MATCH SIMPLE
		ON UPDATE NO ACTION
		ON DELETE NO ACTION
);

CREATE TABLE public.blogs (
	id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
	name VARCHAR(15) NOT NULL,
	description VARCHAR(500) NOT NULL,
	website_url VARCHAR(100) NOT NULL,
	is_membership BOOLEAN NOT NULL DEFAULT false,
	created_at TIMESTAMP NOT NULL DEFAULT NOW(),
	deleted_at TIMESTAMP DEFAULT NULL
);

CREATE TABLE public.posts (
	id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
	blog_id UUID NOT NULL,
	title VARCHAR(30) NOT NULL,
	short_description VARCHAR(100) NOT NULL,
	content VARCHAR(1000) NOT NULL,
	likes_count INT NOT NULL DEFAULT 0 CHECK (likes_count >= 0),
	dislikes_count INT NOT NULL DEFAULT 0 CHECK (dislikes_count >= 0),
	created_at TIMESTAMP NOT NULL DEFAULT NOW(),
	deleted_at TIMESTAMP DEFAULT NULL,
	FOREIGN KEY (blog_id)
		REFERENCES public.blogs (id) MATCH SIMPLE
		ON UPDATE NO ACTION
		ON DELETE NO ACTION
);

CREATE TABLE public.post_likes_data (
	id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
	post_id UUID NOT NULL,
	blog_id UUID NOT NULL,
	user_id UUID NOT NULL,
	like_status VARCHAR(7) NOT NULL CHECK (like_status IN ('Like', 'Dislike')),
	added_at TIMESTAMP NOT NULL DEFAULT NOW(),
	deleted_at TIMESTAMP DEFAULT NULL,
	UNIQUE (post_id, user_id),
	FOREIGN KEY (post_id)
		REFERENCES public.posts (id) MATCH SIMPLE
		ON UPDATE NO ACTION
		ON DELETE NO ACTION,
	FOREIGN KEY (blog_id)
		REFERENCES public.blogs (id) MATCH SIMPLE
		ON UPDATE NO ACTION
		ON DELETE NO ACTION,
	FOREIGN KEY (user_id)
		REFERENCES public.users (id) MATCH SIMPLE
		ON UPDATE NO ACTION
		ON DELETE NO ACTION
);

CREATE TABLE public.comments (
	id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
	post_id UUID NOT NULL,
	blog_id UUID NOT NULL,
	user_id UUID NOT NULL,
	content VARCHAR(300) NOT NULL,
	likes_count INT NOT NULL DEFAULT 0 CHECK (likes_count >= 0),
	dislikes_count INT NOT NULL DEFAULT 0 CHECK (dislikes_count >= 0),
	created_at TIMESTAMP NOT NULL DEFAULT NOW(),
	deleted_at TIMESTAMP DEFAULT NULL,
	FOREIGN KEY (post_id)
		REFERENCES public.posts (id) MATCH SIMPLE
		ON UPDATE NO ACTION
		ON DELETE NO ACTION,
	FOREIGN KEY (blog_id)
		REFERENCES public.blogs (id) MATCH SIMPLE
		ON UPDATE NO ACTION
		ON DELETE NO ACTION,
	FOREIGN KEY (user_id)
		REFERENCES public.users (id) MATCH SIMPLE
		ON UPDATE NO ACTION
		ON DELETE NO ACTION
);

CREATE TABLE public.comment_likes_data (
	id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
	comment_id UUID NOT NULL,
	post_id UUID NOT NULL,
	blog_id UUID NOT NULL,
	user_id UUID NOT NULL,
	like_status VARCHAR(6) NOT NULL CHECK (like_status IN ('Like', 'Dislike')),
	added_at TIMESTAMP NOT NULL DEFAULT NOW(),
	deleted_at TIMESTAMP DEFAULT NULL,
	UNIQUE (comment_id, user_id),
	FOREIGN KEY (comment_id)
		REFERENCES public.comments (id) MATCH SIMPLE
		ON UPDATE NO ACTION
		ON DELETE NO ACTION,
	FOREIGN KEY (post_id)
		REFERENCES public.posts (id) MATCH SIMPLE
		ON UPDATE NO ACTION
		ON DELETE NO ACTION,
	FOREIGN KEY (blog_id)
		REFERENCES public.blogs (id) MATCH SIMPLE
		ON UPDATE NO ACTION
		ON DELETE NO ACTION,
	FOREIGN KEY (user_id)
		REFERENCES public.users (id) MATCH SIMPLE
		ON UPDATE NO ACTION
		ON DELETE NO ACTION
);

